# SAFHANDLE network=safrochain-testnet
# Options: safrochain-testnet | safrochain-mainnet
SAFHANDLE_NETWORK=safrochain-testnet

# Override contract address (optional; defaults from config/*.json)
# SAFHANDLE_CONTRACT_ADDRESS=addr_safro1...

# RPC endpoint override (optional)
# SAFHANDLE_RPC_URL=https://rpc.testnet.safrochain.com

# REST endpoint override (optional)
# SAFHANDLE_REST_URL=https://rest.testnet.safrochain.com
