# SAFLINK network=safrochain-testnet
# Options: safrochain-testnet | safrochain-mainnet
SAFLINK_NETWORK=safrochain-testnet

# Override contract address (optional; defaults from config/*.json)
# SAFLINK_CONTRACT_ADDRESS=addr_safro1...

# RPC endpoint override (optional)
# SAFLINK_RPC_URL=https://rpc.testnet.safrochain.com

# REST endpoint override (optional)
# SAFLINK_REST_URL=https://rest.testnet.safrochain.com
